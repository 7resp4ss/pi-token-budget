{
	"name": "pi-token-budget",
	"version": "1.1.0",
	"description": "Token-budget context window management for pi: no-summary window rollover, notes checkpoints, and read-only history recovery. Replaces summarization compaction.",
	"type": "module",
	"license": "MIT",
	"main": "src/index.ts",
	"keywords": [
		"pi-package"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"smoke": "node --experimental-strip-types src/tests/smoke.ts",
		"integration": "node --experimental-strip-types src/tests/integration.ts",
		"contract": "node --experimental-strip-types src/tests/pi-agent-core-contract.ts",
		"test": "npm run smoke && npm run integration && npm run contract"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "0.84.4",
		"@earendil-works/pi-coding-agent": "0.84.4",
		"@types/node": "22.19.19",
		"typebox": "1.3.7",
		"typescript": "5.9.3"
	}
}
