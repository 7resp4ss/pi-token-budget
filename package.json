{
	"name": "pi-token-budget",
	"version": "1.1.3",
	"description": "No-summary context-window rollover for Pi with durable notes checkpoints, history recovery, and a post-fallback tool-call fence.",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"coding-agent",
		"context-window",
		"context-management",
		"token-budget",
		"compaction",
		"llm",
		"ai-agent",
		"developer-tools"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/7resp4ss/pi-token-budget.git"
	},
	"homepage": "https://github.com/7resp4ss/pi-token-budget#readme",
	"bugs": {
		"url": "https://github.com/7resp4ss/pi-token-budget/issues"
	},
	"main": "src/index.ts",
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"smoke": "node --experimental-strip-types src/tests/smoke.ts",
		"integration": "node --experimental-strip-types src/tests/integration.ts",
		"contract": "node --experimental-strip-types src/tests/pi-agent-core-contract.ts",
		"test": "npm run smoke && npm run integration && npm run contract"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "0.84.4",
		"@earendil-works/pi-coding-agent": "0.84.4",
		"@types/node": "22.19.19",
		"typebox": "1.3.7",
		"typescript": "5.9.3"
	}
}
